float myVariable;

// "when started" hat block
int whenStarted1() {
  Drivetrain.setDriveVelocity(100.0, percent);
  Drivetrain.setTurnVelocity(100.0, percent);
  armmotor.setStopping(hold);
  Intake.setStopping(hold);
  armmotor.setVelocity(40.0, percent);
  armmotor.setMaxTorque(40.0, percent);
  Intake.setVelocity(75.0, percent);
  Intake.setMaxTorque(75.0, percent);
  return 0;
}

// "when Controller ButtonEUp pressed" hat block
void onevent_ControllerButtonEUp_pressed_0() {
  armmotor.spinFor(forward, 1.0, turns, true);
  Intake.spinFor(reverse, 1.0, turns, true);
  armmotor.spinFor(reverse, 1.0, turns, true);
}


int main() {
  // Initializing Robot Configuration. DO NOT REMOVE!
  vexcodeInit();

  // register event handlers
  Controller.ButtonEUp.pressed(onevent_ControllerButtonEUp_pressed_0);

  wait(15, msec);
  whenStarted1();
}
